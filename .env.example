# Public site URL used for SEO metadata, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://omarhenidi.com

# Google Analytics measurement ID (optional — leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KEDCG4FGKE

# Google Search Console verification (HTML tag content value only, not the full meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here

# Contact form email (Gmail SMTP)
# 1. Enable 2FA on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password as SMTP_PASS
CONTACT_TO=omarhenidi@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=omarhenidi@gmail.com
SMTP_PASS=your_google_app_password_here
SMTP_FROM=omarhenidi@gmail.com
